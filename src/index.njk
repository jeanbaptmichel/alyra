<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alyra: Your backlink partner, built for AI search</title>
<meta name="description" content="Alyra helps companies become visible in AI-generated answers by identifying influential sources and building relevant third-party visibility.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32">
<link rel="icon" href="/favicon-16.png" sizes="16x16">
<link rel="apple-touch-icon" href="/apple-touch-icon-180.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#EFEAE0">
<link rel="alternate" hreflang="en" href="/">
<link rel="alternate" hreflang="fr" href="/fr/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=Inter:wght@300..600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  /* --- Ground --- */
  --stone:            #EFEAE0;
  --stone-deep:       #E6E0D4;
  --card:             #F7F4EE;

  /* --- Ink --- */
  --ink:              #1C1B16;
  --ink-70:           #4A473D;
  --ink-45:           #7A7568;

  /* --- Accent (single) --- */
  --petrol:           #14363C;
  --petrol-deep:       #0E262B;
  --petrol-press:      #0A1D21;
  --petrol-light:      #6FA8AE;
  --petrol-wash:       #D5DEDD;
  --petrol-soft:       #3C6A70;

  /* --- Lines --- */
  --hairline:          #D8D2C4;
  --hairline-strong:   #C4BCA9;
  --hairline-dark:     #34322A;

  /* --- Semantic --- */
  --success:           #3E5A3A;
  --error:              #A32B1C;

  /* --- Footer / dark ground --- */
  --footer-bg:          #1C1B16;
  --footer-text:        #CFC9BB;
  --footer-muted:       #A7A196;
  --footer-label:       #7A7568;

  /* --- Type --- */
  --font-serif: "Newsreader", Georgia, serif;
  --font-sans:  "Inter", system-ui, -apple-system, sans-serif;
  --font-mono:  "IBM Plex Mono", ui-monospace, monospace;

  --radius: 0px;
  --container: 1180px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:0.01ms !important;animation-iteration-count:1 !important;transition-duration:0.01ms !important;scroll-behavior:auto !important;}
}
body{
  background:var(--stone);
  color:var(--ink);
  font-family:var(--font-sans);
  font-size:17px;
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
p,h1,h2{text-wrap:pretty;}
.container{max-width:var(--container);margin:0 auto;padding:0 clamp(20px,5vw,64px);}

:focus-visible{outline:2px solid var(--petrol);outline-offset:2px;}
.hero :focus-visible,.alyra-plate :focus-visible{outline-color:var(--petrol-light);}

h1,h2,h3{font-family:var(--font-serif);font-weight:400;line-height:1.15;}
h1{letter-spacing:-0.015em;}
h2{letter-spacing:-0.005em;}
h3{letter-spacing:0;}
.serif-italic{font-style:italic;font-weight:400;}

.eyebrow{
  font-family:var(--font-mono);
  font-size:11px;
  font-weight:400;
  letter-spacing:0.12em;
  text-transform:uppercase;
  color:var(--petrol);
  margin-bottom:14px;
  display:block;
}

.btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-family:var(--font-sans);
  font-size:15px;
  font-weight:500;
  cursor:pointer;
  border-radius:var(--radius);
  transition:background .15s ease-out, color .15s ease-out, border-color .15s ease-out;
  white-space:nowrap;
}
.btn-primary{background:var(--petrol);color:var(--card);padding:14px 26px;border:0;}
.btn-primary:hover{background:var(--petrol-deep);}
.btn-primary:active{background:var(--petrol-press);}
.btn-primary:focus-visible{outline:2px solid var(--petrol);outline-offset:2px;}
.btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--ink);padding:13px 25px;}
.btn-ghost:hover{background:var(--ink);color:var(--stone);}
.btn-ghost:focus-visible{outline:2px solid var(--petrol);outline-offset:2px;}
@media (max-width:640px){
  .btn{width:100%;justify-content:center;}
}

.badge{
  font-family:var(--font-mono);
  font-size:10.5px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  padding:6px 10px;
  display:inline-block;
  border-radius:var(--radius);
}
.badge-accent{background:var(--petrol-wash);color:var(--petrol);}

/* ---------- NAV ---------- */
header{
  position:sticky;top:0;z-index:100;
  background:rgba(239,234,224,0.9);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--hairline);
}
nav{
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 28px;max-width:var(--container);margin:0 auto;
}
.logo{display:flex;align-items:center;}
.logo img{height:26px;width:auto;display:block;}
.nav-right{display:flex;align-items:center;gap:32px;}
.nav-links{display:flex;gap:32px;font-size:14.5px;font-family:var(--font-sans);color:var(--ink-70);}
.nav-links a:hover{color:var(--ink);}
.nav-cta{display:flex;align-items:center;}
.nav-mobile-toggle{display:none;width:44px;height:44px;background:none;border:0;padding:0;margin:0;color:var(--ink);cursor:pointer;}
@media (max-width:860px){
  .nav-links{display:none;}
  .logo img{height:24px;}
  .nav-mobile-toggle{display:flex;align-items:center;justify-content:center;}
  nav{padding:14px 20px;}
  .btn-primary{padding:11px 16px;font-size:13.5px;}
}

/* ---------- MOBILE MENU (full-screen overlay) ---------- */
.mobile-menu{
  position:fixed;inset:0;z-index:200;background:var(--stone);
  display:flex;flex-direction:column;
  opacity:0;visibility:hidden;transform:translateY(-8px);
  transition:opacity .2s ease-out, transform .2s ease-out, visibility .2s;
}
.mobile-menu.open{opacity:1;visibility:visible;transform:translateY(0);}
@media (min-width:861px){.mobile-menu{display:none;}}
.mobile-menu-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 28px;border-bottom:1px solid var(--hairline);
}
.mobile-menu-close{width:44px;height:44px;background:none;border:0;padding:0;margin:0;color:var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;}
.mobile-menu-links{display:block;flex:1;overflow-y:auto;padding:8px 28px;max-width:none;margin:0;}
.mobile-menu-links a,.mobile-menu-item{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:20px 0;border-bottom:1px solid var(--hairline);
  font-family:var(--font-serif);font-size:22px;color:var(--ink);
}
.mobile-menu-item{color:var(--ink-45);}
.mobile-menu-item .tag{
  font-family:var(--font-mono);font-size:10px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-45);
}
.mobile-menu-links svg{flex-shrink:0;color:var(--ink-45);}
.mobile-menu-foot{padding:20px 28px 32px;border-top:1px solid var(--hairline);}
.mobile-menu-foot .btn-primary{width:100%;justify-content:center;}
.lang-toggle{display:flex;margin-top:16px;border:1px solid var(--hairline-strong);width:fit-content;}
.lang-toggle-btn{
  padding:10px 20px;font-family:var(--font-mono);font-size:12px;letter-spacing:0.06em;
  color:var(--ink-70);
}
.lang-toggle-btn.active{background:var(--ink);color:var(--stone);}

.nav-dropdown{position:relative;}
.nav-dropdown-trigger{
  display:inline-flex;align-items:center;gap:6px;
  background:none;border:0;padding:0;margin:0;
  font-family:var(--font-sans);font-size:14.5px;color:var(--ink-70);cursor:pointer;
}
.nav-dropdown-trigger:hover{color:var(--ink);}
.nav-dropdown-caret{transition:transform .15s ease-out;}
.nav-dropdown:hover .nav-dropdown-caret,.nav-dropdown:focus-within .nav-dropdown-caret{transform:rotate(180deg);}
.nav-dropdown-menu{
  position:absolute;top:100%;left:-16px;padding-top:14px;min-width:210px;
  opacity:0;visibility:hidden;transform:translateY(-4px);
  transition:opacity .15s ease-out, transform .15s ease-out, visibility .15s;
  z-index:50;
}
.nav-dropdown:hover .nav-dropdown-menu,.nav-dropdown:focus-within .nav-dropdown-menu{
  opacity:1;visibility:visible;transform:translateY(0);
}
.nav-dropdown-menu > a,.nav-dropdown-menu > .nav-dropdown-item{
  display:block;background:var(--card);border:1px solid var(--hairline);border-top:0;
  padding:12px 16px;font-size:14.5px;color:var(--ink-70);
}
.nav-dropdown-menu > a:first-child,.nav-dropdown-menu > .nav-dropdown-item:first-child{border-top:1px solid var(--hairline);}
.nav-dropdown-menu > a:hover{background:var(--stone-deep);color:var(--ink);}
.nav-dropdown-item{color:var(--ink-45);cursor:default;}
.nav-dropdown-item .tag{
  font-family:var(--font-mono);font-size:9.5px;letter-spacing:0.06em;text-transform:uppercase;
  color:var(--ink-45);display:block;margin-top:2px;
}
.nav-dropdown-item.current-lang{color:var(--petrol);font-weight:500;}

/* ---------- HERO ("Plate" ground, from the brand identity system) ---------- */
.hero{
  position:relative;overflow:hidden;
  margin:0 clamp(20px,5vw,64px);
  background:linear-gradient(176deg,#0B2226 0%,#14363C 38%,#1B454B 64%,#2A5A5F 100%);
  padding:clamp(72px,10vw,128px) 0 clamp(56px,8vw,90px);text-align:center;
}
/* layer 1 — ruling: 1px hairlines at 9px, faded in from 34% */
.hero::before{
  content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(180deg, rgba(239,234,224,0.10) 0px, rgba(239,234,224,0.10) 1px, transparent 1px, transparent 9px);
  -webkit-mask-image:linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.5) 34%, #000 100%);
          mask-image:linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.5) 34%, #000 100%);
  pointer-events:none;
}
/* layer 2 — grain, kept above the ruling via overlay blend */
.hero::after{
  content:"";position:absolute;inset:0;
  opacity:0.30;mix-blend-mode:overlay;
  background-image:url("/assets/brand/grain.svg");
  background-size:180px 180px;
  pointer-events:none;
}
@media (prefers-reduced-transparency: reduce){.hero::after{display:none;}}
/* layer 3 — glow, off-canvas anchored so it never resolves into a light source */
.hero-glow{
  position:absolute;inset:0;
  background:radial-gradient(120% 70% at 78% 108%, rgba(111,168,174,0.45) 0%, rgba(111,168,174,0.12) 38%, transparent 66%);
  pointer-events:none;
}
/* layer 4 — hem, dissolves the plate into the page instead of a hard edge */
.hero-hem{
  position:absolute;left:0;right:0;bottom:0;height:22%;
  background:linear-gradient(180deg, transparent 0%, #EFEAE0 100%);
  pointer-events:none;
}
.hero .container{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;}
.hero h1{font-size:clamp(38px,5.2vw,62px);max-width:820px;color:#F2EFE7;font-weight:500;}
.hero-logo-rotator{
  position:relative;display:inline-block;width:0.82em;height:0.82em;
  vertical-align:-0.12em;margin:0 0.12em;
  border:1px solid var(--hairline-strong);border-radius:50%;background:var(--card);
}
.hero-logo-rotator img{
  position:absolute;inset:0;margin:auto;width:48%;height:48%;object-fit:contain;
  opacity:0;animation:logoRotate 8s infinite;
}
.hero-logo-rotator img:nth-child(1){animation-delay:0s;}
.hero-logo-rotator img:nth-child(2){animation-delay:2s;}
.hero-logo-rotator img:nth-child(3){animation-delay:4s;}
.hero-logo-rotator img:nth-child(4){animation-delay:6s;}
@keyframes logoRotate{0%{opacity:0;}4%{opacity:1;}21%{opacity:1;}25%{opacity:0;}100%{opacity:0;}}
@media (prefers-reduced-motion: reduce){
  .hero-logo-rotator img{animation:none;opacity:1;}
  .hero-logo-rotator img:not(:first-child){display:none;}
}
@media (max-width:640px){
  .hero-line2{display:block;font-size:0.6em;margin-top:8px;}
}
.hero-sub{margin:24px auto 0;font-size:18px;line-height:1.65;color:#D3CFC4;max-width:560px;}
.hero-ctas{margin-top:36px;display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;}
.link-underline{font-size:15px;color:var(--ink-70);border-bottom:1px solid var(--hairline-strong);padding-bottom:2px;transition:color .15s ease-out, border-color .15s ease-out;}
.link-underline:hover{color:var(--ink);border-color:var(--ink);}
/* petrol is invisible on the plate ground — invert the primary button, lighten the secondary link */
.hero .btn-primary{background:#EFEAE0;color:#1C1B16;}
.hero .btn-primary:hover{background:#FFFDF7;}
.hero .link-underline{color:#D3CFC4;border-bottom-color:rgba(239,234,224,0.4);}
.hero .link-underline:hover{color:#EFEAE0;border-color:#EFEAE0;}

/* ---------- BIG STATEMENT ---------- */
.statement{padding:clamp(72px,10vw,128px) 0;text-align:center;}
.statement-inner{max-width:760px;margin:0 auto;}
.statement h2{font-size:clamp(32px,4.6vw,50px);}
.statement p{margin:26px auto 0;font-size:18px;line-height:1.65;color:var(--ink-70);max-width:600px;}

/* ---------- SECTION HEADER (shared) ---------- */
.section{padding:clamp(72px,10vw,128px) 0;}
.section-head{max-width:640px;margin-bottom:56px;}
.section-head h2{font-size:clamp(28px,3.6vw,38px);}
.section-head p{margin-top:18px;font-size:17px;line-height:1.65;color:var(--ink-70);}
.section.on-line{border-top:1px solid var(--hairline);}

/* ---------- HOW IT WORKS (scrollytelling) ---------- */
.how-scrollarea{position:relative;height:340vh;margin-top:8px;}
.how-pin{position:sticky;top:0;height:100vh;display:flex;align-items:center;padding:20px 0;}
@media (min-width:901px){
  .how-pin{align-items:flex-start;padding-top:64px;}
}
.how-grid{display:grid;grid-template-columns:0.85fr 1.15fr;gap:64px;width:100%;}
@media (max-width:900px){
  .how-scrollarea{height:auto;margin-top:0;}
  .how-pin{position:static;height:auto;display:block;padding:0;}
  .how-grid{grid-template-columns:1fr;gap:36px;}
}
.step-list{align-self:start;}
.step-item{
  display:flex;gap:20px;padding:22px 0;border-top:1px solid var(--hairline);cursor:pointer;
}
.step-item:last-child{border-bottom:1px solid var(--hairline);}
.step-num{
  font-family:var(--font-mono);font-size:13px;letter-spacing:0.04em;color:var(--ink-45);min-width:24px;padding-top:2px;transition:color .15s ease-out;
}
.step-body h3{font-family:var(--font-serif);font-weight:500;font-size:20px;color:var(--ink-45);transition:color .15s ease-out;margin-bottom:6px;}
.step-body p{font-family:var(--font-sans);font-size:15px;color:var(--ink-45);max-height:0;overflow:hidden;transition:max-height .35s ease, opacity .15s ease-out, color .15s ease-out;opacity:0;}
.step-item.active .step-num{color:var(--petrol);}
.step-item.active .step-body h3{color:var(--ink);}
.step-item.active .step-body p{max-height:100px;opacity:1;color:var(--ink-70);margin-top:2px;}
.step-mobile-panel{display:none;}
@media (max-width:900px){
  .step-body p{max-height:none;opacity:1;color:var(--ink-70);margin-top:2px;}
  .step-num{color:var(--petrol);}
  .step-body h3{color:var(--ink);}
  .step-mobile-panel{
    display:block;margin-top:16px;background:var(--card);border:1px solid var(--hairline);
    border-radius:var(--radius);padding:22px 20px;
  }
}

.step-visual{
  background:var(--card);border:1px solid var(--hairline);border-radius:var(--radius);
  padding:32px;min-height:380px;position:relative;overflow:hidden;
}
@media (max-width:900px){.step-visual{display:none;}}
.step-panel{display:none;}
.step-panel.active{display:block;animation:mockIn .15s ease-out;}
.panel-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--hairline);font-size:14.5px;}
.panel-row:last-child{border-bottom:none;}
.panel-row .muted{color:var(--ink-45);}
@keyframes mockIn{from{opacity:0;}to{opacity:1;}}

/* ---------- ALYRA PLATE (dark ground component: tile / photo-background card) ---------- */
.alyra-plate{position:relative;overflow:hidden;}
.alyra-plate::before{
  content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(180deg, rgba(239,234,224,0.10) 0px, rgba(239,234,224,0.10) 1px, transparent 1px, transparent 9px);
  pointer-events:none;
}
.alyra-plate::after{
  content:"";position:absolute;inset:0;
  opacity:0.30;mix-blend-mode:overlay;
  background-image:url("/assets/brand/grain.svg");
  background-size:180px 180px;
  pointer-events:none;
}
@media (prefers-reduced-transparency: reduce){.alyra-plate::after{display:none;}}
.alyra-plate--tile{
  background:linear-gradient(168deg,#0B2226 0%,#14363C 55%,#24565B 100%);
  min-height:176px;
}
.alyra-plate--tile::before{
  -webkit-mask-image:linear-gradient(180deg, transparent 10%, #000 100%);
          mask-image:linear-gradient(180deg, transparent 10%, #000 100%);
}
.alyra-plate__inner{position:relative;z-index:1;}
.alyra-plate--tile .alyra-plate__inner{
  padding:24px;display:flex;flex-direction:column;height:100%;box-sizing:border-box;
}
.alyra-plate__eyebrow{
  font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol-light);
}
.alyra-plate h3{
  font-family:var(--font-serif);font-weight:500;line-height:1.25;letter-spacing:-0.015em;color:#F2EFE7;
  font-size:22px;margin-top:auto;
}

/* ---------- PROOF TILE (branded background behind the sources mockup) ---------- */
.proof-tile{min-height:420px;display:flex;align-items:center;}
.proof-tile .alyra-plate__inner{
  width:100%;display:flex;flex-direction:column;align-items:center;text-align:center;
  padding:clamp(48px,7vw,80px) clamp(24px,5vw,64px);
}
.proof-tile h2{color:#F2EFE7;font-size:clamp(26px,3.4vw,36px);max-width:560px;}
.proof-mock{
  margin-top:32px;width:100%;max-width:440px;text-align:left;
  background:var(--card);border:1px solid var(--hairline);
}
.proof-mock .panel-row{padding:14px 20px;}
.proof-annotation{
  margin-top:22px;font-family:var(--font-serif);font-style:italic;font-weight:400;
  font-size:16px;color:var(--petrol-light);
}

/* ---------- FEATURE ROWS (value props) ---------- */
.feature-row{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
.feature-row.reverse .feature-visual{order:-1;}
@media (max-width:900px){
  .feature-row{grid-template-columns:1fr;gap:36px;}
  .feature-row.reverse .feature-visual{order:0;}
}
.feature-text h2{font-size:clamp(26px,3.4vw,38px);}
.feature-text p{margin-top:18px;font-size:17px;line-height:1.65;color:var(--ink-70);max-width:460px;}
.feature-visual{width:100%;}

/* ---------- OUTBOUND SECTION (pinned card swap) ---------- */
.outbound-scrollarea{position:relative;height:220vh;}
.outbound-pin{position:sticky;top:0;height:100vh;display:flex;align-items:center;padding:20px 0;}
@media (max-width:900px){
  .outbound-scrollarea{height:auto;}
  .outbound-pin{position:static;height:auto;display:block;padding:0;}
}
.outbound-panel{display:none;}
.outbound-panel.active{display:block;animation:mockIn .15s ease-out;}
@media (max-width:900px){
  .outbound-panel{display:block !important;margin-bottom:24px;}
  .outbound-panel:last-child{margin-bottom:0;}
}

/* ---------- MAP VISUAL (feature row 1) ---------- */
.map-wrap{position:relative;height:420px;display:flex;align-items:center;justify-content:center;}
.map-center{
  width:150px;height:150px;border-radius:50%;background:var(--ink);color:var(--stone);
  display:flex;align-items:center;justify-content:center;text-align:center;font-size:14px;font-weight:400;
  position:relative;z-index:3;padding:10px;font-family:var(--font-serif);font-style:italic;
}
.map-node{
  position:absolute;background:var(--card);border:1px solid var(--hairline);border-radius:var(--radius);
  padding:10px 14px;font-size:13px;z-index:3;min-width:130px;
}
.map-node .node-label{font-weight:500;margin-bottom:3px;font-family:var(--font-sans);}
.map-node .node-tag{font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.04em;text-transform:uppercase;color:var(--ink-45);}
svg.map-lines{position:absolute;inset:0;width:100%;height:100%;z-index:1;}
svg.map-lines path{stroke:var(--hairline-strong);stroke-width:1.4;fill:none;stroke-dasharray:220;stroke-dashoffset:220;transition:stroke-dashoffset 1.1s ease-out;}
svg.map-lines path.high{stroke:var(--petrol);}
.map-wrap.in-view svg.map-lines path{stroke-dashoffset:0;}
@media (max-width:640px){
  .map-wrap{height:380px;}
  .map-center{width:110px;height:110px;font-size:12px;}
  .map-node{padding:8px 10px;font-size:11.5px;min-width:110px;}
  .map-node .node-tag{font-size:9.5px;}
}

/* ---------- OUTBOUND VISUAL (feature row 2) ---------- */
.email-mock{background:var(--card);border:1px solid var(--hairline);border-radius:var(--radius);padding:0;overflow:hidden;}
.email-head{padding:18px 24px;border-bottom:1px solid var(--hairline);font-size:13.5px;color:var(--ink-45);}
.email-head .field{display:flex;gap:10px;margin-bottom:6px;}
.email-head .field b{color:var(--ink-70);font-weight:500;min-width:52px;}
.email-body{padding:24px;font-size:15px;color:var(--ink-70);line-height:1.65;}
.email-body p{margin-bottom:14px;}
.email-body .sign{color:var(--ink-45);font-size:14px;}

.pipeline{display:flex;flex-direction:column;justify-content:center;gap:0;background:var(--card);border:1px solid var(--hairline);border-radius:var(--radius);padding:24px 24px 4px;}
.pipe-step{display:flex;gap:16px;position:relative;padding-bottom:32px;}
.pipe-step:last-child{padding-bottom:8px;}
.pipe-step::before{
  content:'';position:absolute;left:9px;top:22px;bottom:-10px;width:1px;background:var(--hairline);
}
.pipe-step:last-child::before{display:none;}
.pipe-dot{width:19px;height:19px;border-radius:50%;border:1px solid var(--hairline-strong);background:var(--card);flex-shrink:0;z-index:1;transition:background .15s ease-out, border-color .15s ease-out;}
.pipe-step.done .pipe-dot{background:var(--petrol);border-color:var(--petrol);}
.pipe-text h4{font-family:var(--font-sans);font-size:16px;font-weight:600;margin-bottom:3px;color:var(--ink);transition:color .15s ease-out;}
.pipe-text p{font-size:14px;color:var(--ink-45);}
.pipe-step.done .pipe-text h4{color:var(--petrol);}

/* ---------- PRICING VISUAL (feature row 3) ---------- */
.price-card{background:var(--card);border:1px solid var(--hairline);border-radius:var(--radius);padding:30px 32px;max-width:420px;margin:0 auto;}
.price-card-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--hairline);}
.price-card-head .label{font-size:13px;color:var(--ink-45);}
.price-card-head .value{font-family:var(--font-serif);font-style:italic;font-size:22px;color:var(--petrol);}
.price-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--hairline);font-size:14.5px;}
.price-row:last-child{border-bottom:none;}
.price-row .muted{color:var(--ink-45);}
.price-row .ok{color:var(--petrol);font-weight:500;}

/* ---------- FINAL CTA ---------- */
.final-cta{padding:clamp(72px,10vw,128px) 0;text-align:center;}
.final-cta h2{font-size:clamp(32px,5vw,52px);max-width:720px;margin:0 auto;}
.final-cta p{margin:22px auto 0;max-width:480px;color:var(--ink-70);font-size:18px;}

/* ---------- DEMO FORM ---------- */
.demo-form{
  text-align:left;background:var(--card);border:1px solid var(--hairline);border-radius:var(--radius);
  max-width:640px;margin:40px auto 0;padding:40px;
}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px 24px;}
.field{display:flex;flex-direction:column;gap:8px;}
.field-full{grid-column:1/-1;}
.field label{font-family:var(--font-sans);font-size:13px;color:var(--ink-70);}
.field input{
  background:var(--card);border:1px solid var(--hairline-strong);border-radius:var(--radius);
  padding:13px 14px;font-family:var(--font-sans);font-size:15px;color:var(--ink);
  transition:border-color .15s ease-out, box-shadow .15s ease-out;
}
.field input::placeholder{color:var(--ink-45);}
.field input:focus{outline:none;border-color:var(--petrol);box-shadow:inset 0 0 0 1px var(--petrol);}
.field-hint{font-size:12.5px;color:var(--ink-45);}
.demo-form .btn-primary{width:100%;justify-content:center;margin-top:28px;}
@media (max-width:640px){
  .demo-form{padding:28px 20px;}
  .form-grid{grid-template-columns:1fr;}
}

/* ---------- WHY US ---------- */
.whyus-wrap{max-width:640px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center;}
.whyus-avatar{width:76px;height:76px;border-radius:50%;object-fit:cover;margin-bottom:28px;border:1px solid var(--hairline-strong);}
.whyus-quote{font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:clamp(21px,2.6vw,27px);line-height:1.5;color:var(--ink);}
.whyus-name{margin-top:22px;font-size:14.5px;font-weight:600;font-family:var(--font-sans);}
.whyus-name .muted{display:block;margin-top:4px;font-weight:400;color:var(--ink-45);}

/* ---------- FOOTER ---------- */
footer{background:var(--footer-bg);padding:56px 0 40px;}
.footer-grid{display:flex;justify-content:space-between;flex-wrap:wrap;gap:40px;}
.footer-brand .logo{margin-bottom:14px;}
.footer-brand .logo img{height:24px;}
.footer-brand p{font-size:14px;color:var(--footer-muted);max-width:220px;}
.footer-brand .btn-primary{margin-top:20px;background:var(--stone);color:var(--ink);}
.footer-brand .btn-primary:hover{background:#FFFDF7;}
.footer-brand .btn-primary:focus-visible{outline-color:var(--petrol-light);}
.footer-cols{display:flex;gap:0;}
.footer-col{padding:0 40px;}
.footer-col:first-child{padding-left:0;}
.footer-col + .footer-col{border-left:1px solid var(--hairline-dark);}
.footer-col h4{font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--footer-label);margin-bottom:14px;font-weight:400;}
.footer-col a{display:block;font-size:14.5px;color:var(--footer-text);margin-bottom:10px;transition:color .15s ease-out;}
.footer-col a:hover{color:var(--petrol-light);}
.footer-bottom{margin-top:56px;padding-top:24px;border-top:1px solid var(--hairline-dark);font-size:13px;color:var(--footer-muted);}
@media (max-width:640px){
  .footer-cols{flex-direction:column;gap:32px;width:100%;}
  .footer-col{padding:0;border-left:none !important;}
}

.reveal{opacity:0;transition:opacity .15s ease-out;}
.reveal.in{opacity:1;}
</style>
