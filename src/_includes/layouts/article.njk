---
layout: layouts/base.njk
---
<article>
  <header>
    <p class="eyebrow">{{ pillar }} · {{ vertical }} · {{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="byline">{{ authors[author].name[lang] }} · {{ date | readableDate }}</p>
  </header>

  {# TL;DR block — required per content format rules: extractable direct-answer
     summary before the narrative. Set `tldr` in the article's frontmatter. #}
  {% if tldr %}
  <div class="tldr">
    <strong>{% if lang == 'fr' %}En bref{% else %}TL;DR{% endif %}</strong>
    <p>{{ tldr }}</p>
  </div>
  {% endif %}

  {{ content | safe }}

  {% include "partials/translation-note.njk" %}

  <footer>
    {% if lang == 'fr' %}<a href="/fr/contact/" class="btn btn-primary">Parler à Alyra →</a>
    {% else %}<a href="/contact/" class="btn btn-primary">Talk to Alyra →</a>{% endif %}
  </footer>
</article>
