---
layout: layouts/base.njk
---
<article>
  <header>
    <p class="eyebrow">{{ pillar }} · {{ vertical }} · {{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="byline">{{ authors[author].name }} · {{ date | readableDate }}</p>
  </header>

  {# TL;DR block — required per content format rules: extractable direct-answer
     summary before the narrative. Set `tldr` in the article's frontmatter. #}
  {% if tldr %}
  <div class="tldr">
    <strong>{% if lang == 'fr' %}En bref{% else %}TL;DR{% endif %}</strong>
    <p>{{ tldr }}</p>
  </div>
  {% endif %}

  {{ content | safe }}

  {% if hreflang and hreflang.length %}
  <p class="translation-note">
    {% for alt in hreflang %}
      <a href="{{ alt.url }}">{% if alt.lang == 'fr' %}Lire en français{% else %}Read in English{% endif %}</a>
    {% endfor %}
  </p>
  {% endif %}

  <footer>
    <p>
      {% if lang == 'fr' %}<a href="/fr/contact/">Parler à Alyra</a>
      {% else %}<a href="/contact/">Talk to Alyra</a>{% endif %}
    </p>
  </footer>
</article>
