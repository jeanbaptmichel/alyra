<header>
  <nav>
    <a href="{% if lang == 'fr' %}/fr/{% else %}/{% endif %}" class="logo"><img src="/assets/brand/lockup-light.svg" alt="Alyra"></a>
    <div class="nav-right">
      <div class="nav-links">
        <a href="/#how">{% if lang == 'fr' %}Comment ça marche{% else %}How it works{% endif %}</a>
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger">
            {% if lang == 'fr' %}Ressources{% else %}Resources{% endif %}
            <svg class="nav-dropdown-caret" width="9" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-dropdown-menu">
            <a href="{% if lang == 'fr' %}/fr/blog/{% else %}/blog/{% endif %}">Blog</a>
            <span class="nav-dropdown-item">
              {% if lang == 'fr' %}Études de cas{% else %}Case Studies{% endif %}
              <span class="tag">{% if lang == 'fr' %}Bientôt{% else %}Coming soon{% endif %}</span>
            </span>
            <span class="nav-dropdown-item">
              {% if lang == 'fr' %}À propos{% else %}About Us{% endif %}
              <span class="tag">{% if lang == 'fr' %}Bientôt{% else %}Coming soon{% endif %}</span>
            </span>
          </div>
        </div>
        {% set otherLangUrl = (hreflang and hreflang.length) and hreflang[0].url or (lang == 'fr' and '/blog/' or '/fr/blog/') %}
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-label="{% if lang == 'fr' %}Changer de langue{% else %}Change language{% endif %}">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <svg class="nav-dropdown-caret" width="9" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-dropdown-menu">
            {% if lang == 'fr' %}
            <a href="{{ otherLangUrl }}">English</a>
            <span class="nav-dropdown-item current-lang">Français</span>
            {% else %}
            <span class="nav-dropdown-item current-lang">English</span>
            <a href="{{ otherLangUrl }}">Français</a>
            {% endif %}
          </div>
        </div>
      </div>
      <div class="nav-cta">
        <a href="{% if lang == 'fr' %}/fr/contact/{% else %}/contact/{% endif %}" class="btn btn-primary">{% if lang == 'fr' %}Réserver une démo →{% else %}Book a demo →{% endif %}</a>
      </div>
    </div>
  </nav>
</header>
