<script>
// ---------- Reveal on scroll ----------
const revealEls = document.querySelectorAll('.reveal');
const revealObs = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){ e.target.classList.add('in'); revealObs.unobserve(e.target); }
  });
},{threshold:0.15});
revealEls.forEach(el=>revealObs.observe(el));

// ---------- How it works: pinned scrollytelling ----------
const howScrollArea = document.getElementById('howScrollArea');
const stepItems = Array.from(document.querySelectorAll('.step-item'));
const stepPanels = Array.from(document.querySelectorAll('.step-panel'));
const numSteps = stepItems.length;

function isDesktopScrolly(){ return window.innerWidth >= 900; }

function setStep(i){
  stepItems.forEach(s=> s.classList.toggle('active', +s.dataset.step === i));
  stepPanels.forEach(p=> p.classList.toggle('active', +p.dataset.panel === i));
}

function updateHowFromScroll(){
  if(!isDesktopScrolly()) return;
  const rect = howScrollArea.getBoundingClientRect();
  const scrollAreaHeight = howScrollArea.offsetHeight;
  const viewportH = window.innerHeight;
  const maxScroll = scrollAreaHeight - viewportH;
  const scrolled = -rect.top;
  let progress = maxScroll > 0 ? scrolled / maxScroll : 0;
  progress = Math.min(1, Math.max(0, progress));
  let idx = Math.floor(progress * numSteps);
  idx = Math.min(numSteps - 1, Math.max(0, idx));
  setStep(idx);
}
window.addEventListener('scroll', updateHowFromScroll, {passive:true});
window.addEventListener('resize', updateHowFromScroll);
updateHowFromScroll();

stepItems.forEach(item=>{
  item.addEventListener('click', ()=>{
    const idx = +item.dataset.step;
    if(isDesktopScrolly()){
      const rect = howScrollArea.getBoundingClientRect();
      const scrollAreaTop = window.scrollY + rect.top;
      const scrollAreaHeight = howScrollArea.offsetHeight;
      const viewportH = window.innerHeight;
      const maxScroll = scrollAreaHeight - viewportH;
      const targetProgress = (idx + 0.5) / numSteps;
      const targetY = scrollAreaTop + targetProgress * Math.max(0, maxScroll);
      window.scrollTo({top: targetY, behavior:'smooth'});
    } else {
      setStep(idx);
    }
  });
});

// ---------- Map lines draw-in ----------
const mapWrap = document.getElementById('mapWrap');
if(mapWrap){
  const mapObs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ mapWrap.classList.add('in-view'); mapObs.unobserve(e.target); }
    });
  },{threshold:0.4});
  mapObs.observe(mapWrap);
}

// ---------- Acquire pipeline sequence ----------
const pipeline = document.getElementById('pipeline');
let pipelinePlayed = false;
function playPipelineOnce(){
  if(pipelinePlayed || !pipeline) return;
  pipelinePlayed = true;
  const steps = pipeline.querySelectorAll('.pipe-step');
  steps.forEach((s,i)=>{
    setTimeout(()=> s.classList.add('done'), i*500);
  });
}
if(pipeline){
  const pipeObs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ playPipelineOnce(); pipeObs.unobserve(e.target); }
    });
  },{threshold:0.5});
  pipeObs.observe(pipeline);
}

// ---------- Outbound section: pinned card swap ----------
const outboundScrollArea = document.getElementById('outboundScrollArea');
if(outboundScrollArea){
  const outboundPanels = Array.from(outboundScrollArea.querySelectorAll('.outbound-panel'));
  function setOutboundPanel(i){
    outboundPanels.forEach(p=> p.classList.toggle('active', +p.dataset.panel === i));
    if(i === 1) playPipelineOnce();
  }
  function updateOutboundFromScroll(){
    if(!isDesktopScrolly()) return;
    const rect = outboundScrollArea.getBoundingClientRect();
    const areaHeight = outboundScrollArea.offsetHeight;
    const viewportH = window.innerHeight;
    const maxScroll = areaHeight - viewportH;
    const scrolled = -rect.top;
    let progress = maxScroll > 0 ? scrolled / maxScroll : 0;
    progress = Math.min(1, Math.max(0, progress));
    setOutboundPanel(progress < 0.5 ? 0 : 1);
  }
  window.addEventListener('scroll', updateOutboundFromScroll, {passive:true});
  window.addEventListener('resize', updateOutboundFromScroll);
  updateOutboundFromScroll();
}
</script>

