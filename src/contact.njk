---
layout: layouts/base.njk
title: "Book a Demo"
description: "See where your company stands in AI-generated answers today, no commitment."
lang: en
hreflang:
  - lang: fr
    url: "/fr/contact/"
---
<section class="final-cta">
  <div class="container">
    <span class="eyebrow">Contact</span>
    <h1>Ready to get discovered by AI?</h1>
    <p>See where you stand today, no commitment.</p>
    <form class="demo-form" action="https://formspree.io/f/mqpkrejo" method="POST">
      <input type="hidden" name="_subject" value="New demo request: Alyra">
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
      <div class="form-grid">
        <div class="field">
          <label for="f-name">Name</label>
          <input type="text" id="f-name" name="name" autocomplete="name" required>
        </div>
        <div class="field">
          <label for="f-org">Organization</label>
          <input type="text" id="f-org" name="organization" autocomplete="organization" required>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input type="email" id="f-email" name="email" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="f-phone">Phone number</label>
          <input type="tel" id="f-phone" name="phone" autocomplete="tel" pattern="^\+[1-9]\d{6,14}$" required>
        </div>
        <div class="field field-full">
          <label for="f-position">Position</label>
          <input type="text" id="f-position" name="position" autocomplete="organization-title" required>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Book a demo →</button>
    </form>
  </div>
</section>
